{
  "name": "@vaultkeeper/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app-type": "./src/app-type.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts",
    "cli": "tsx --env-file-if-exists=../../.env src/cli/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@hono/zod-validator": "0.9.1",
    "@vaultkeeper/shared": "workspace:*",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "msw": "3.0.4",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15"
  }
}
