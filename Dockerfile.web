# syntax=docker/dockerfile:1
# Web image (task 7.2): the PWA production bundle served by Caddy, which also reverse-proxies
# /api, /media and /healthz to the api service. Build from the repo root:
#   docker build -f Dockerfile.web .

FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/
COPY packages/api-client/package.json packages/api-client/
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter @vaultkeeper/web...
COPY tsconfig.base.json ./
COPY packages packages
COPY apps/api apps/api
COPY apps/web apps/web
# VITE_* are build-time and public (never secrets). Empty API URL = same origin (ADR9).
ARG VITE_API_URL=
ARG VITE_APP_NAME=Vaultkeeper
ENV VITE_API_URL=$VITE_API_URL VITE_APP_NAME=$VITE_APP_NAME
RUN pnpm --filter @vaultkeeper/web build

FROM caddy:2-alpine AS runtime
COPY --from=build /repo/apps/web/dist /srv/web
COPY Caddyfile /etc/caddy/Caddyfile
