# Vaultkeeper environment (design 15). Copy to .env and fill in; .env is never committed.
# The API validates these at boot (apps/api/src/config/env.ts) and exits on invalid values.
# Values below are DEVELOPMENT placeholders.

# --- API ---
NODE_ENV=development
PORT=3000
# Public origin of the app (Better Auth baseURL). Production: https://<DOMAIN>
PUBLIC_URL=http://localhost:5173
# Comma-separated extra origins (dev only)
EXTRA_TRUSTED_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://vaultkeeper:vaultkeeper@localhost:5432/vaultkeeper
# >= 32 chars. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# OAuth pairs are optional, but each pair must be set together or left empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Defaults to /data/media (container volume). Dev uses a gitignored local dir.
MEDIA_DIR=./.data/media
UPLOAD_MAX_BYTES=1048576
CSV_MAX_BYTES=2097152
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Docker Compose only ---
# Production domain served by Caddy
DOMAIN=vaultkeeper.example.com
POSTGRES_USER=vaultkeeper
POSTGRES_PASSWORD=vaultkeeper
POSTGRES_DB=vaultkeeper

# --- Ops scripts (ops/backup.sh, ops/restore.sh) ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# PRODUCTION ONLY: lets the ops scripts resolve the prod media volume name. Left commented on
# purpose: if set in a dev .env it would override `name: vaultkeeper-dev` in docker-compose.dev.yml.
# COMPOSE_PROJECT_NAME=vaultkeeper

# --- Tests (export in your shell; Vitest does not read .env) ---
# Fallback for the api-int suite when Docker/Testcontainers is unavailable: any Postgres 17 server.
# The harness creates and drops vk_template and t_<id> databases on it.
# VK_TEST_DATABASE_URL=postgres://vaultkeeper:vaultkeeper@localhost:5432/vaultkeeper

# --- Web (Vite, build-time; never put secrets in VITE_*) ---
# Empty = same origin
VITE_API_URL=
VITE_APP_NAME=Vaultkeeper
